<% content_for :title, t("garden_map.title") %>
<% content_for :head, stylesheet_link_tag("leaflet") if @settings.map_mode? %>
<h1><%= t("garden_map.title") %></h1>

<p>
  <%= link_to t("garden_map.beds_link"), garden_beds_path, class: "btn btn-secondary" %>
  <%= link_to t("garden_bed.catalog_link"), plants_path, class: "btn btn-secondary" %>
  <% if @settings.property? %>
    <%= link_to t("garden_map.plan.link"), plan_garden_map_path, class: "btn btn-secondary" %>
  <% end %>
</p>
<p class="caption"><%= t("garden_map.intro") %></p>

<%# ---- Grundstück capture (map mode only) --------------------------------- %>
<% if @settings.map_mode? %>
  <% admin = policy(@settings).update? %>
  <div class="card card-flat garden-map-wrap"
       data-controller="garden-map"
       data-garden-map-config-value="<%= Garden::MapSources.client_config(@settings).to_json %>"
       data-garden-map-center-value="<%= @settings.effective_center.to_json %>"
       data-garden-map-zoom-value="<%= @settings.effective_zoom %>"
       data-garden-map-property-value="<%= (@settings.property_boundary || []).to_json %>"
       data-garden-map-structures-value="<%= garden_map_structures_json(@structures).to_json %>"
       data-garden-map-token-value="<%= form_authenticity_token %>"
       data-garden-map-property-url-value="<%= admin ? property_garden_map_path : "" %>"
       data-garden-map-structures-url-value="<%= admin ? garden_structures_path : "" %>"
       data-garden-map-parcel-url-value="<%= Garden::MapSources.parcel_source(@settings) ? parcel_garden_map_path : "" %>"
       data-i18n-draw-hint="<%= t("garden_map.draw.hint") %>"
       data-i18n-draw-need-points="<%= t("garden_map.draw.need_points") %>"
       data-i18n-save-failed="<%= t("garden_map.save_failed") %>"
       data-i18n-area-label="<%= t("garden_map.area_label") %>"
       data-i18n-parcel-hint="<%= t("garden_map.parcel.hint") %>"
       data-i18n-parcel-official="<%= t("garden_map.parcel.official_area") %>"
       data-i18n-parcel-not-found="<%= t("garden_map.parcel.not_found") %>">
    <h2><%= t("garden_map.property.heading") %></h2>
    <p class="caption"><%= t("garden_map.property.hint") %></p>
    <div class="garden-map-toolbar">
      <label><input type="checkbox" data-garden-map-target="dopToggle"
                    data-action="garden-map#toggleDop"> <%= t("garden_map.layers.dop") %></label>
      <label><input type="checkbox" data-garden-map-target="alkisToggle"
                    data-action="garden-map#toggleAlkis"> <%= t("garden_map.layers.alkis") %></label>
      <% if Garden::MapSources.parcel_source(@settings) %>
        <button type="button" class="btn btn-sm btn-secondary"
                data-action="garden-map#toggleParcelPick"><%= t("garden_map.parcel.button") %></button>
      <% end %>
      <% if admin %>
        <button type="button" class="btn btn-sm btn-secondary"
                data-action="garden-map#startDraw">
          <%= @settings.property? ? t("garden_map.property.redraw") : t("garden_map.property.draw") %>
        </button>
        <% if @settings.property? %>
          <button type="button" class="btn btn-sm btn-secondary"
                  data-action="garden-map#clearProperty"><%= t("garden_map.property.clear") %></button>
          <button type="button" class="btn btn-sm btn-secondary"
                  data-action="garden-map#startDrawStructure"><%= t("garden_structure.draw") %></button>
        <% end %>
      <% end %>
      <span class="caption" data-garden-map-target="readout"></span>
    </div>
    <div class="garden-map" data-garden-map-target="map"></div>
    <p class="caption" data-garden-map-target="drawControls" hidden>
      <button type="button" class="btn btn-sm" data-action="garden-map#finishDraw"><%= t("garden_map.draw.finish") %></button>
      <button type="button" class="btn btn-sm btn-secondary" data-action="garden-map#cancelDraw"><%= t("garden_map.draw.cancel") %></button>
    </p>
    <% if admin %>
      <p class="caption" data-garden-map-target="adoptControls" hidden>
        <button type="button" class="btn btn-sm" data-action="garden-map#adoptParcel"><%= t("garden_map.parcel.adopt") %></button>
      </p>
    <% end %>

    <% if admin && (@structures.any? || @settings.property?) %>
      <h3 class="garden-map-beds-heading"><%= t("garden_structure.heading") %></h3>
      <% if @structures.empty? %>
        <p class="caption"><%= t("garden_structure.empty") %></p>
      <% else %>
        <p class="caption"><%= t("garden_structure.hint") %></p>
        <table>
          <thead>
            <tr>
              <th><%= t("garden_structure.name") %></th>
              <th><%= t("garden_structure.kind") %></th>
              <th><%= t("garden_structure.height") %></th>
              <th><%= t("garden_structure.footprint") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @structures.each do |structure| %>
              <tr>
                <td><input type="text" name="garden_structure[name]" value="<%= structure.name %>"
                           maxlength="80" required form="structure-form-<%= structure.id %>"></td>
                <td>
                  <select name="garden_structure[kind]" form="structure-form-<%= structure.id %>">
                    <% GardenStructure::KINDS.each do |kind| %>
                      <option value="<%= kind %>" <%= "selected" if structure.kind == kind %>>
                        <%= t("garden_structure.kinds.#{kind}") %>
                      </option>
                    <% end %>
                  </select>
                </td>
                <td><input type="number" name="garden_structure[height_m]" value="<%= structure.height_m.to_f %>"
                           min="0.5" max="50" step="0.1" inputmode="decimal" style="width:5.5rem"
                           form="structure-form-<%= structure.id %>"> m</td>
                <td><%= t("garden_map.area_label", area: number_with_precision(structure.area_sqm, precision: 1)) %></td>
                <td style="display:flex;gap:var(--sp-1)">
                  <button type="submit" form="structure-form-<%= structure.id %>" class="btn btn-sm secondary">
                    <%= t("common.save") %>
                  </button>
                  <%= button_to t("common.delete"), garden_structure_path(structure),
                                method: :delete, class: "btn btn-sm warn",
                                data: { turbo_confirm: t("garden_structure.confirm_delete") },
                                form: { style: "display:inline" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <%# Form shells outside the table (a <form> may not sit inside <tr>);
            the row inputs attach via their form="" attribute. %>
        <% @structures.each do |structure| %>
          <%= form_with model: structure, url: garden_structure_path(structure),
                        method: :patch, local: true, id: "structure-form-#{structure.id}" do %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if admin %>
      <%= render "settings_form", settings: @settings %>
    <% end %>
  </div>
  <p class="caption"><%= t("garden_map.attribution_note") %></p>
<% elsif policy(@settings).update? %>
  <div class="card card-flat">
    <%= render "settings_form", settings: @settings %>
  </div>
<% end %>

<%# ---- to-scale planner (always) ------------------------------------------- %>
<div class="card card-flat"
     data-controller="garden-lite"
     data-garden-lite-beds-value="<%= garden_map_beds_json(@garden_beds).to_json %>"
     data-garden-lite-property-value="<%= (@settings.property_boundary || []).to_json %>"
     data-garden-lite-structures-value="<%= garden_map_structures_json(@structures).to_json %>"
     data-garden-lite-token-value="<%= form_authenticity_token %>"
     data-i18n-save-failed="<%= t("garden_map.save_failed") %>"
     data-i18n-area-label="<%= t("garden_map.area_label") %>">
  <h2><%= t("garden_map.planner.heading") %></h2>
  <p class="caption">
    <%= t("garden_map.lite.position_hint") %>
    <% if @settings.property? && @settings.property_area_sqm %>
      · <%= t("garden_map.property.area",
              area: number_with_precision(@settings.property_area_sqm, precision: 1)) %>
    <% end %>
  </p>
  <% if @garden_beds.empty? %>
    <p><%= t("garden_map.no_beds_html", link: link_to(t("garden_bed.add"), new_garden_bed_path)) %></p>
  <% end %>
  <div class="garden-lite-canvas">
    <svg data-garden-lite-target="svg" class="garden-lite-svg" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>
  <p class="caption"><%= t("garden_map.lite.scale_legend") %></p>

  <% if @garden_beds.any? %>
    <h3 class="garden-map-beds-heading"><%= t("garden_map.beds_heading") %></h3>
    <table>
      <thead>
        <tr>
          <th><%= t("garden_bed.field.name") %></th>
          <th><%= t("garden_map.lite.width") %></th>
          <th><%= t("garden_map.lite.length") %></th>
          <th><%= t("garden_bed.field.area") %></th>
        </tr>
      </thead>
      <tbody>
        <% @garden_beds.each do |bed| %>
          <tr data-bed-id="<%= bed.id %>">
            <td><%= link_to bed.name, garden_bed_path(bed) %></td>
            <td><input type="number" min="0.1" max="1000" step="0.1" inputmode="decimal"
                       value="<%= bed.width_m&.to_f %>" data-garden-lite-target="width"
                       data-bed-id="<%= bed.id %>" data-action="change->garden-lite#dimensionChanged"></td>
            <td><input type="number" min="0.1" max="1000" step="0.1" inputmode="decimal"
                       value="<%= bed.length_m&.to_f %>" data-garden-lite-target="length"
                       data-bed-id="<%= bed.id %>" data-action="change->garden-lite#dimensionChanged"></td>
            <td data-garden-lite-target="bedArea" data-bed-id="<%= bed.id %>">
              <%= t("garden_map.area_label", area: number_with_precision(bed.area_sqm, precision: 1)) if bed.area_sqm %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
